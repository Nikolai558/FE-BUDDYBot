# Copy to bot.env and fill in. Never commit bot.env.
# Any setting in appsettings.json can be overridden here: "Section:Key" becomes Section__Key.

# Required: production bot token from the Discord Developer Portal (Bot tab).
Bot__Token=

# Optional: Discord webhook that is notified if the bot restarts after losing its connection.
Bot__DisconnectWebhookUrl=

# Optional: status text shown under the bot's name.
Bot__Status=

# Optional: Uptime Kuma push monitor. Use the push URL WITHOUT the "?status=up..." part.
Heartbeat__Enabled=false
Heartbeat__Url=

# Optional: GitHub App for FE-BUDDY issue reporting (see Docs/GitHub App Setup.md).
# Uncomment both lines once the app exists. The key file is mounted from ./secrets (see docker-compose.yml).
#GitHub__AppId=
#GitHub__PrivateKeyPath=secrets/github-app.pem
